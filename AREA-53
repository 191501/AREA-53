<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#050505">
<title>Area-53</title>
<style>
:root{--bg:#050505;--line:#1a1a1a;--line2:#141414;--text:#f2f2f2;--muted:#777;--dim:#333;--ac:#002fa7;--ac-hi:#4a7cff;--ac-dim:#001a5c;--mono:Menlo,Consolas,monospace;--display:"Rajdhani","Arial Narrow",sans-serif;--sans:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font:15px/1.75 var(--sans);-webkit-font-smoothing:antialiased}
body.booting{overflow:hidden}
body.booting #page{opacity:0}
body.ready #page{transition:opacity .6s}

/* 开启动画 */
#intro{position:fixed;inset:0;z-index:9;display:flex;flex-direction:column;background:#050505;padding:24px;transition:.6s}
#intro.done{opacity:0;visibility:hidden;pointer-events:none}
#intro .stage{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
#intro .eyebrow{font:10px var(--mono);letter-spacing:.4em;color:var(--muted);text-transform:uppercase;margin-bottom:18px}
#intro h1{font:600 clamp(36px,10vw,72px)/1 var(--display);color:#fff;margin-bottom:10px}
#intro h1 span{color:var(--ac-hi)}
#intro .sub{font:500 12px var(--display);letter-spacing:.28em;color:var(--muted);text-transform:uppercase;margin-bottom:36px}
#intro h2{font:600 18px var(--display);letter-spacing:.22em;color:#fff;margin-bottom:6px}
#intro .sub2{font:10px var(--mono);letter-spacing:.32em;color:var(--muted);text-transform:uppercase;margin-bottom:24px}
#intro .track{width:min(420px,80vw);height:1px;background:#1a1a1a;overflow:hidden;margin-bottom:10px}
#intro .bar{height:100%;width:0;background:linear-gradient(90deg,var(--ac),var(--ac-hi));transition:width .25s}
#intro .meta{width:min(420px,80vw);display:flex;justify-content:space-between;font:10px var(--mono);letter-spacing:.16em;color:var(--muted);text-transform:uppercase}
#intro .meta .ac{color:var(--ac-hi)}
#intro .foot{display:flex;justify-content:space-between;padding-top:14px;border-top:1px solid var(--line);font:10px var(--mono);letter-spacing:.2em;color:var(--dim);text-transform:uppercase}

/* 页面 */
.hero{padding:60px 24px 30px;border-bottom:1px solid var(--line);text-align:center}
.hero .eyebrow{font:10px var(--mono);letter-spacing:.42em;color:var(--muted);text-transform:uppercase;margin-bottom:20px}
.hero h1{font:600 clamp(36px,9vw,72px)/1 var(--display);color:#fff;margin-bottom:12px}
.hero h1 span{color:var(--ac-hi)}
.hero .subtitle{font:500 12px var(--display);letter-spacing:.28em;color:var(--muted);text-transform:uppercase}

#hdr{position:sticky;top:0;z-index:5;background:rgba(5,5,5,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
#hdr .w{display:flex;align-items:center;gap:14px;max-width:820px;margin:0 auto;padding:12px 20px}
#hdr .sysid{font:700 13px var(--mono);letter-spacing:.14em;color:var(--ac-hi);padding:5px 10px;border:1px solid var(--ac-dim);border-radius:2px}
#hdr h1{font-size:14px;color:#fff}
#hdr .sec-tag{margin-left:auto;font:10px var(--mono);letter-spacing:.18em;color:var(--muted);padding:5px 10px;border:1px solid var(--line)}
#hdr .sec-tag b{color:var(--ac-hi);font-weight:400}

#content{max-width:820px;margin:0 auto;padding:36px 20px 0}
.alert{display:flex;gap:11px;margin-bottom:28px;padding:12px 16px;border-left:3px solid var(--ac-hi);background:rgba(0,47,167,.08);font-size:13px;color:#a8bcf0}
.alert strong{color:var(--ac-hi)}

.sec{display:flex;align-items:center;gap:10px;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--line);font:600 13px var(--display);letter-spacing:.22em;text-transform:uppercase;color:var(--ac-hi)}
.sec:before{content:"";width:3px;height:14px;background:var(--ac-hi)}
section{margin-bottom:32px}

.row{display:flex;gap:14px;padding:10px 0;border-bottom:1px solid var(--line2);font-size:14px}
.row:last-child{border:none}
.row b{flex:0 0 5.6em;color:var(--muted);font-size:13px;font-weight:400;font-family:var(--mono)}
.row span{flex:1}
.kv{width:100%;border-collapse:collapse;font-size:13.5px}
.kv th,.kv td{padding:10px 12px;border-bottom:1px solid var(--line2);text-align:left;font-weight:400}
.kv tr:last-child th,.kv tr:last-child td{border:none}
.kv th{width:55%;color:var(--muted);font-size:13px}
.kv td{text-align:right;font:13px var(--mono);color:var(--text)}
.kv td strong{color:#fff;font-size:15px}

.inbox-card{display:block;width:100%;margin-bottom:32px;background:#0a0a0a;border:1px solid var(--line);cursor:pointer;text-align:left;color:inherit;font-family:inherit;transition:border-color .2s}
.inbox-card:hover{border-color:var(--ac-hi)}
.inbox-card .row-top{display:flex;align-items:center;gap:14px;padding:16px 20px;border-bottom:1px solid var(--line2)}
.inbox-card svg{width:22px;height:22px;color:var(--ac-hi);flex:0 0 auto}
.inbox-card .meta{flex:1;min-width:0}
.inbox-card .from{font-size:14px;font-weight:600;color:#fff;display:flex;gap:8px}
.inbox-card .from .badge{padding:2px 7px;border:1px solid var(--ac-dim);color:var(--ac-hi);font:9.5px/1.6 var(--mono);letter-spacing:.2em}
.inbox-card .subject{margin-top:4px;font-size:13px;color:#a4b6cf;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inbox-card .time{flex:0 0 auto;font:10.5px var(--mono);color:var(--muted);text-align:right}
.inbox-card .time .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--ac-hi);margin-right:6px}
.inbox-card .hint{padding:10px 20px;font:10.5px var(--mono);letter-spacing:.16em;color:var(--dim);background:#000}
.inbox-card .hint .arrow{color:var(--ac-hi);margin-right:6px}

.mail{display:none;margin-bottom:32px;background:#0a0a0a;border:1px solid var(--line)}
.mail.open{display:block}
.mail .top{display:flex;gap:10px;padding:10px 14px;background:#000;border-bottom:1px solid var(--line);font:10.5px var(--mono);color:var(--muted)}
.mail .top .p{margin-left:auto;color:var(--dim)}
.mail .head{padding:18px 22px 14px;border-bottom:1px solid var(--line2)}
.mail .subj{display:flex;gap:10px;margin-bottom:14px;font-size:15px;font-weight:600;color:#fff}
.mail .subj .b{padding:2px 7px;border:1px solid var(--ac-dim);color:var(--ac-hi);font:9.5px/1.6 var(--mono);letter-spacing:.2em}
.mail .subj .u{margin-left:auto;font:10px var(--mono);color:var(--ac-hi)}
.mf{display:flex;gap:12px;padding:3px 0;font-size:13px}
.mf .k{flex:0 0 4.2em;font:11px var(--mono);color:var(--muted);padding-top:2px}
.mf .v{flex:1;color:var(--text)}
.mf .v b{color:#fff}
.mf .v .a{font:12px var(--mono);color:var(--ac-hi)}
.mail .body{padding:20px 22px 8px;font-size:14px;line-height:1.95;color:#c8c8c8}
.mail .body p{margin-bottom:14px;text-align:justify}
.mail .body p:last-child{margin-bottom:0}
.redact{display:inline-block;padding:0 3px;background:#0a0a0a;color:#0a0a0a;border:1px solid #1a1a1a}
.mail .sign{margin:20px 22px 0;padding:12px 16px;border-left:3px solid var(--ac);background:rgba(0,47,167,.06);font:11.5px var(--mono);line-height:1.8;color:#a8bcf0}
.mail .sign .n{color:var(--ac-hi);font-weight:600}
.mail .sign .r{color:var(--muted);font-size:11px}
.mail .note{margin-top:20px;padding:10px 22px;border-top:1px solid var(--line);background:#000;font:10px var(--mono);letter-spacing:.14em;color:var(--muted)}
.mail .note .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#5fbf7f;margin-right:6px}

.bottom-meta{margin-top:44px;padding:22px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;font:10px var(--mono);letter-spacing:.2em;color:var(--dim);text-transform:uppercase}
.bottom-meta .pcm{color:var(--muted)}
.ftr{margin-top:32px;padding:22px 20px 30px;border-top:1px solid var(--line);text-align:center;font:10px var(--mono);letter-spacing:.2em;color:var(--dim)}
.ftr span{color:var(--muted)}

@media(max-width:479px){
  .hero{padding:44px 18px 24px}
  #hdr .w{padding:10px 14px;gap:10px}
  #hdr .sysid{font-size:11.5px;padding:4px 8px}
  #hdr h1{font-size:13px}
  #content{padding:28px 14px 0}
  .mail .head{padding:14px 14px 12px}
  .mail .body{padding:16px 14px 6px;font-size:13.5px}
  .mail .sign{margin:16px 14px 0;padding:10px 12px}
}
</style>
</head>
<body class="booting">

<div id="intro">
  <div class="stage">
    <p class="eyebrow">Secure Facility Dossier</p>
    <h1>SYS://<span>53</span></h1>
    <p class="sub">SCP Foundation · Secure Channel</p>
    <h2>建立安全连接</h2>
    <p class="sub2">ESTABLISH SECURE CONNECTION</p>
    <div class="track"><div class="bar" id="introBar"></div></div>
    <div class="meta">
      <span id="introPct">PCM 0%</span>
      <span class="ac" id="introTag">SYNCING</span>
    </div>
  </div>
  <div class="foot">
    <span>AREA-53 / SITE-916 联合管理部</span>
    <span>S.C.P.</span>
  </div>
</div>

<div id="page">

<section class="hero">
  <p class="eyebrow">Secure Facility Dossier</p>
  <h1>AREA<span>-53</span></h1>
  <p class="subtitle">SCP Foundation · Secure Channel</p>
</section>

<header id="hdr">
  <div class="w">
    <div class="sysid">SYS://53</div>
    <h1>安保设施档案</h1>
    <div class="sec-tag">SEC LV <b>3</b></div>
  </div>
</header>

<main id="content">

  <div class="alert"><span style="color:var(--ac-hi)">●</span><p><strong>警告：</strong>本文档仅限授权人员访问。</p></div>

  <button class="inbox-card" id="inboxBtn" type="button">
    <div class="row-top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="1.5"/>
        <path d="M3.5 6.5 L12 13 L20.5 6.5"/>
      </svg>
      <div class="meta">
        <div class="from"><span>netzach</span><span class="badge">WELCOME</span></div>
        <div class="subject">欢迎，以及若干必须现在就说明的事</div>
      </div>
      <div class="time"><span class="dot"></span>09:14</div>
    </div>
    <div class="hint"><span class="arrow">▸</span>点击查收邮件</div>
  </button>

  <article class="mail" id="mailBox">
    <div class="top">
      <span>SecureMail · Internal</span>
      <span class="p">inbox / area-53 / welcome</span>
    </div>
    <div class="head">
      <div class="subj"><span class="b">WELCOME</span>欢迎来到 Area-53<span class="u">● 未读</span></div>
      <div class="mf"><span class="k">From</span><span class="v"><b>netzach</b> <span class="a">&lt;netzach@area-53.scp.int&gt;</span></span></div>
      <div class="mf"><span class="k">Date</span><span class="v"><span style="font:12px var(--mono);color:var(--muted)">2023-05-29 09:14:07</span></span></div>
    </div>
    <div class="body">
      <p>让我们现在就来解决几个问题。</p>
      <p>首先，我觉得你是一名刚了解并加入基金会的员工。欢迎来到我们这个站点了解工作。当然，别听你的同事怎么说那些东西有多么吓人，我们绝对不会排高位异常给你进行工作的——毕竟你死了，我的名声和处罚我是承担不起的。也就是说他们并没有撒谎：有谁愿意住在垃圾桶里，又有谁愿意和重收容那些东西做邻居呢？</p>
      <p>当然别乱跑，老老实实待在自己的工位上，拉了警报就给我跑进避难所里，否则你出了事情我可不负责。很多设施比我们这还糟，所以别发牢骚，除非你想<span class="redact">████</span>。</p>
      <p>第二，你肯定听过 Area-53 的前身 Site-178。但你可能不知道的是，当时我并不负责这个设施。<span class="redact">████</span> 是个懦夫，他害死了很多人。我的做事风格与他们那群 <span class="redact">███</span> 和那所谓的 <span class="redact">██</span> 议会有所不同。</p>
      <p>特别是，我尽我所能让我的员工——也就是你，无论你带着什么东西，都能——活着。</p>
    </div>
    <div class="sign">
      <div class="n">netzach</div>
      <div class="r">Area-53 主管 / Site Director</div>
    </div>
    <div class="note"><span class="dot"></span>本邮件已加密存档 · 请勿外传</div>
  </article>

  <section>
    <h2 class="sec">基本信息</h2>
    <div class="row"><b>成立时间</b><span>2023 年 5 月 29 日</span></div>
    <div class="row"><b>站点创始人</b><span>Dr. netzach</span></div>
    <div class="row"><b>地点</b><span>芬兰 ████</span></div>
    <div class="row"><b>成立目的</b><span>收容大型异常 · 向收容失效站点输送人力 · 转运异常 · 培训人员</span></div>
  </section>

  <section>
    <h2 class="sec">在站人员</h2>
    <table class="kv"><tbody>
      <tr><th>总人数</th><td><strong>2689</strong></td></tr>
      <tr><th>行政人员</th><td>11</td></tr>
      <tr><th>医生</th><td>223</td></tr>
      <tr><th>安保人员</th><td>138</td></tr>
      <tr><th>维修人员</th><td>122</td></tr>
      <tr><th>驻站 MTF</th><td>134</td></tr>
      <tr><th>收容专家</th><td>45</td></tr>
      <tr><th>研究人员</th><td>187</td></tr>
      <tr><th>D 级人员</th><td>158</td></tr>
      <tr><th>其他人员</th><td>112</td></tr>
    </tbody></table>
  </section>

  <div class="bottom-meta">
    <span>AREA-53 / SITE-916 联合管理部</span>
    <span class="pcm">S.C.P.</span>
  </div>
</main>

<footer class="ftr"><span>SCP 基金会</span> · 控制 · 收容 · 保护</footer>

</div>

<script>
(function(){
  var i=document.getElementById("intro"),b=document.getElementById("introBar"),pct=document.getElementById("introPct"),tg=document.getElementById("introTag"),p=0,d=0,t=0;
  var S=[[0,"SYNCING"],[24,"AUTH"],[48,"DECRYPT"],[72,"ASSEMBLE"],[90,"READY"]];
  function tick(){
    if(d)return;
    p+=Math.random()*5+1.5;if(p>100)p=100;
    b.style.width=p+"%";pct.textContent="PCM "+Math.floor(p)+"%";
    for(var k=S.length-1;k>=0;k--){if(p>=S[k][0]){tg.textContent=S[k][1];break}}
    p<100?t=setTimeout(tick,120+Math.random()*180):setTimeout(fin,420);
  }
  function fin(){
    if(d)return;d=1;clearTimeout(t);
    b.style.width="100%";pct.textContent="PCM 100%";tg.textContent="READY";
    setTimeout(function(){
      i.classList.add("done");document.body.className="ready";
      setTimeout(function(){i.parentNode.removeChild(i)},800);
    },320);
  }
  function sk(){if(d)return;clearTimeout(t);fin()}
  i.onclick=sk;i.ontouchstart=sk;
  document.addEventListener("keydown",function(e){if(e.key==="Escape"||e.key==="Enter"||e.key===" ")sk()},true);
  setTimeout(tick,300);
  setTimeout(function(){if(!d)fin()},8000);
})();
(function(){
  var btn=document.getElementById("inboxBtn"),box=document.getElementById("mailBox");
  if(!btn||!box)return;
  btn.onclick=function(){
    var h=btn.querySelector(".hint"),open=box.classList.toggle("open");
    h.innerHTML=open?'<span class="arrow">▾</span>点击收起邮件':'<span class="arrow">▸</span>点击查收邮件';
  };
})();
</script>
</body>
</html>
